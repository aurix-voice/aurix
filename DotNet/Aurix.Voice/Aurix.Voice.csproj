<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the Unity Runtime sources as a plain .NET Standard 2.1 library (also usable from
       dedicated game servers, bots and tests). Unity itself compiles the Runtime/ folder directly. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Aurix.Voice</AssemblyName>
    <RootNamespace>Aurix</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" />
  </ItemGroup>
</Project>
