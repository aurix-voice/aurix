# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
POSTGRES_USER=aurix_prod
POSTGRES_PASSWORD=
POSTGRES_DB=aurix

AURIX_EXTERNAL_URL=https://voice.example.com
AURIX_CORS_ORIGINS=https://game.example.com
# CIDRs of your reverse proxy / load balancer, so X-Forwarded-For is trusted for rate limiting
AURIX_TRUSTED_PROXIES=
AURIX_PUBLIC_IP=203.0.113.10

AURIX_JWT_SECRET=
# One-time token that allows POST /admin/setup to create the first admin. Remove after use.
AURIX_ADMIN_BOOTSTRAP_TOKEN=

# Same value on every node; enables automatic SFU-to-SFU cascade for multi-node channels (>=16 chars).
AURIX_CASCADE_SECRET=
AURIX_TURN_ENABLED=true
AURIX_TURN_REALM=voice.example.com
AURIX_TURN_SECRET=
AURIX_TURN_MIN_PORT=49160
AURIX_TURN_MAX_PORT=49200

AURIX_RECORDING_ENABLED=false
AURIX_RECORDING_ENCRYPTION_ENABLED=false
AURIX_RECORDING_ENCRYPTION_KEY=

AURIX_LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=
