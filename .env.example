# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
POSTGRES_USER=aurix_prod
POSTGRES_PASSWORD=
POSTGRES_DB=aurix

AURIX_EXTERNAL_URL=https://voice.example.com
# Public WebSocket URL of this node (defaults to wss://<external host>/ws). One per node, not the LB.
AURIX_EXTERNAL_WS_URL=
# Region label used by discovery: us_east, us_west, eu_west, eu_central, asia_pacific,
# south_america, australia, middle_east, africa
AURIX_REGION=us_east
AURIX_CORS_ORIGINS=https://game.example.com
# CIDRs of your reverse proxy / load balancer, so X-Forwarded-For is trusted for rate limiting
AURIX_TRUSTED_PROXIES=
AURIX_PUBLIC_IP=203.0.113.10
# Optional dual-stack: public IPv6 of the host + bind media/TURN on `::` (needs Docker IPv6 or host networking).
#AURIX_PUBLIC_IPV6=2001:db8::10
#AURIX_MEDIA_BIND=::

AURIX_JWT_SECRET=
# One-time token that allows POST /admin/setup to create the first admin. Remove after use.
AURIX_ADMIN_BOOTSTRAP_TOKEN=

# Same value on every node; enables automatic SFU-to-SFU cascade for multi-node channels (>=16 chars).
AURIX_CASCADE_SECRET=
AURIX_TURN_ENABLED=true
AURIX_TURN_REALM=voice.example.com
AURIX_TURN_SECRET=
AURIX_TURN_MIN_PORT=49160
AURIX_TURN_MAX_PORT=49200

AURIX_RECORDING_ENABLED=false
AURIX_RECORDING_ENCRYPTION_ENABLED=false
AURIX_RECORDING_ENCRYPTION_KEY=

AURIX_LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=

# Operator dashboard (service `dashboard`). Default publishes only on localhost; put Traefik/Caddy
# in front, or set AURIX_DASHBOARD_PORT=80 and AURIX_DASHBOARD_ADDRESS to a public hostname.
AURIX_DASHBOARD_PORT=127.0.0.1:8090
AURIX_DASHBOARD_ADDRESS=:8080
# Proxies in front of the dashboard whose X-Forwarded-* headers are trusted (Caddy syntax).
AURIX_DASHBOARD_TRUSTED_PROXIES=private_ranges
