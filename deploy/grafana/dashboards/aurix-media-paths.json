      "type": "timeseries",
      "title": "Live stream frames/s",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 65
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "sent = queued for the consumer; dropped = consumer too slow or outage buffer overflowed. The media path never blocks on a consumer.",
      "targets": [
