      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "operator (stop request), channel_stopped, duration_limit, consumer_disconnected (pull without outage buffer), consumer_timeout (pull consumer never resumed), push_unreachable (push target down past the outage window), server_shutdown.",
      "targets": [
        {
          "expr": "sum by (reason) (increase(aurix_live_streams_closed_total[1h]))",
