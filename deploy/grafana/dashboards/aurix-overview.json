{
  "title": "Aurix Voice \u2014 Overview",
  "uid": "aurix-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active sessions / channels",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(aurix_active_sessions)",
          "legendFormat": "sessions",
          "refId": "A"
        },
        {
          "expr": "sum(aurix_active_channels)",
          "legendFormat": "channels",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Media packets/s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aurix_packets_received_total[1m]))",
          "legendFormat": "in",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aurix_packets_sent_total[1m]))",
          "legendFormat": "out",
          "refId": "B"
        },
        {
          "expr": "sum(rate(aurix_packets_dropped_total[1m]))",
          "legendFormat": "dropped",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Media bandwidth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aurix_bytes_received_total[1m]))*8",
          "legendFormat": "in",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aurix_bytes_sent_total[1m]))*8",
          "legendFormat": "out",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TURN allocations / STUN req/s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(aurix_turn_allocations)",
          "legendFormat": "allocations",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aurix_stun_requests_total[1m]))",
          "legendFormat": "stun rps",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests/s by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(aurix_api_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rate-limit hits/s & active bans",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aurix_rate_limit_hits_total[1m]))",
          "legendFormat": "rate-limit hits",
          "refId": "A"
        },
        {
          "expr": "sum(aurix_active_bans)",
          "legendFormat": "bans",
          "refId": "B"
        }
      ]
    }
  ]
}