{
  "name": "@aurix/server-sdk",
  "version": "1.4.0",
  "description": "Server-side (backend) SDK for the Aurix voice platform REST API: token issuance, channels, moderation, webhooks, SSE. Generated from api/openapi.json.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
