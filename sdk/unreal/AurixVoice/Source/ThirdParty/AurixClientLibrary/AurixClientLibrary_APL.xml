<?xml version="1.0" encoding="utf-8"?>
<!-- Android Plugin Language: ship libaurix_client.so for every ABI the build targets and load it
     before the game module so the AurixVoice module's imports resolve. -->
<root xmlns:android="http://schemas.android.com/apk/res/android">
  <init>
    <log text="AurixClientLibrary APL: staging libaurix_client.so"/>
  </init>
  <resourceCopies>
    <isArch arch="arm64-v8a">
      <copyFile src="$S(PluginDir)/lib/Android/arm64-v8a/libaurix_client.so" dst="$S(BuildDir)/libs/arm64-v8a/libaurix_client.so"/>
    </isArch>
    <isArch arch="armeabi-v7a">
      <copyFile src="$S(PluginDir)/lib/Android/armeabi-v7a/libaurix_client.so" dst="$S(BuildDir)/libs/armeabi-v7a/libaurix_client.so"/>
    </isArch>
    <isArch arch="x86_64">
      <copyFile src="$S(PluginDir)/lib/Android/x86_64/libaurix_client.so" dst="$S(BuildDir)/libs/x86_64/libaurix_client.so"/>
    </isArch>
  </resourceCopies>
  <soLoadLibrary>
    <loadLibrary name="aurix_client" failmsg="libaurix_client.so not found in the APK"/>
  </soLoadLibrary>
  <androidManifestUpdates>
    <addPermission android:name="android.permission.RECORD_AUDIO"/>
    <addPermission android:name="android.permission.INTERNET"/>
    <addPermission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  </androidManifestUpdates>
</root>
