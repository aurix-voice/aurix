{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.4.0",
  "FriendlyName": "Aurix Voice",
  "Description": "Self-hosted game voice chat (Aurix): encrypted native AURX audio over QUIC/UDP (WebSocket tunnel fallback), WebSocket control plane, Opus with FEC/DRED, capture DSP, per-participant sound waves for engine spatialization, group E2EE, priority speakers, text chat, moderation, transcripts, translation and TTS. Wraps the aurix-client C ABI; the AurixVoiceSamples module adds Blueprint-ready lobby and proximity components.",
  "Category": "Audio",
  "CreatedBy": "Aurix contributors",
  "CreatedByURL": "https://github.com/aurix-voice/aurix",
  "DocsURL": "https://github.com/aurix-voice/aurix/blob/main/sdk/unreal/AurixVoice/Docs/QuickStart.md",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/aurix-voice/aurix/issues",
  "EngineVersion": "5.3.0",
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": false,
  "Installed": false,
  "SupportedTargetPlatforms": ["Win64", "Linux", "Mac"],
  "Modules": [
    {
      "Name": "AurixVoice",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Linux", "Mac"]
    },
    {
      "Name": "AurixVoiceSamples",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Linux", "Mac"]
    }
  ],
  "Plugins": [
    {
      "Name": "AudioCapture",
      "Enabled": true
    }
  ]
}
